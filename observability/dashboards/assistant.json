{
  "uid": "assistant",
  "title": "Assistant \u2014 LLM cost, latency and safety",
  "tags": [
    "assistant",
    "llm",
    "gen_ai"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Spend (1h)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(assistant_llm_cost_usd_total[1h]))) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Suspicious proposals (1h)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(assistant_proposals_total{assistant_suspicious=\"true\"}[1h]))) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Injection flags (1h)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(assistant_injection_flags_total[1h]))) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Turns hitting a budget (1h)",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(assistant_turns_total{assistant_turn_outcome=~\"call_budget|token_budget\"}[1h]))) or vector(0)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens / s by model and type",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model, gen_ai_token_type) (rate(gen_ai_client_token_usage_sum[5m]))",
          "legendFormat": "{{gen_ai_request_model}} {{gen_ai_token_type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 model latency",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{gen_ai_request_model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Proposals: requested vs suspicious",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (assistant_suspicious) (rate(assistant_proposals_total[5m]))",
          "legendFormat": "suspicious={{assistant_suspicious}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(assistant_confirmations_total[5m]))",
          "legendFormat": "confirmed"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool calls by outcome",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_tool_name, assistant_tool_outcome) (rate(assistant_tool_calls_total[5m]))",
          "legendFormat": "{{gen_ai_tool_name}} {{assistant_tool_outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Escalations, fallbacks, turns",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(assistant_escalations_total[5m]))",
          "legendFormat": "escalations"
        },
        {
          "refId": "B",
          "expr": "sum by (gen_ai_request_model) (rate(assistant_provider_fallbacks_total[5m]))",
          "legendFormat": "fallback {{gen_ai_request_model}}"
        },
        {
          "refId": "C",
          "expr": "sum by (assistant_turn_outcome) (rate(assistant_turns_total[5m]))",
          "legendFormat": "turns {{assistant_turn_outcome}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Assistant logs",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"library\", app=\"assistant\"} != \"/healthz\" != \"/metrics\""
        }
      ]
    }
  ]
}